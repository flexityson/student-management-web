# Supabase Database Configuration
# Copy this file to .env and replace with your actual values

# Supabase Project URL (for both frontend and backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Public) - For client-side usage
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Secret) - For server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Environment
NODE_ENV=production

# Teacher Access Code - Required for signup
VITE_TEACHER_ACCESS_CODE=TEACHER123
TEACHER_ACCESS_CODE=TEACHER123

# Vercel Dashboard Variables (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_TEACHER_ACCESS_CODE=TEACHER123

# Vercel Environment Variables (set these in Vercel dashboard)
# VERCEL_ENV=production
# VERCEL_URL=your-vercel-app-url.vercel.app
