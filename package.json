{
  "name": "studenthub-management",
  "version": "2.0.0",
  "description": "Professional Student Management System - A modern, responsive, and accessible student management interface",
  "main": "src/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vercel --prod",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write src/**/*.{js,jsx,css,md}",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug"
  },
  "keywords": [
    "student-management",
    "education",
    "dashboard",
    "analytics",
    "responsive",
    "accessible",
    "modern",
    "supabase",
    "vercel",
    "serverless"
  ],
  "author": "StudentHub Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/studenthub-management.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/studenthub-management/issues"
  },
  "homepage": "https://github.com/your-username/studenthub-management#readme",
  "engines": {
    "node": "18.x"
  },
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.0",
    "vite": "^4.4.0",
    "vercel": "^28.0.0"
  }
}
